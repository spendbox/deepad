# Copy these into Vercel: Project -> Settings -> Environment Variables.

# Password for your own admin page at /admin. REQUIRED.
ADMIN_PASSWORD=

# Long random text that protects everyone's logins. REQUIRED.
ADMIN_SESSION_SECRET=

# Supabase: Project Settings -> API. REQUIRED.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: Settings -> API Keys & Webhooks.
# sk_test_… = test mode (fake money). sk_live_… = real money.
PAYSTACK_SECRET_KEY=
# Optional: which bank gives events their account numbers. Default: titan-paystack (Paystack-Titan).
# Other choice: wema-bank. (Test mode always uses Paystack's test bank.)
PAYSTACK_DVA_BANK=

# Email for planners' after-event reports, via resend.com (free plan is fine).
RESEND_API_KEY=
EMAIL_FROM=DashPad <reports@yourdomain.com>

# Any long random text. Lets Vercel run the daily clean-up job.
CRON_SECRET=

# Optional: your site's public address (e.g. https://dashpad.site), used in event links.
NEXT_PUBLIC_SITE_URL=

# Optional: background removal for celebrant photos. FAPIhub (fapihub.com) has 100 free photos a month.
FAPIHUB_API_KEY=
# Or Photoroom (photoroom.com/api), used only if FAPIHUB_API_KEY is empty.
PHOTOROOM_API_KEY=

# Optional but recommended: AI check of the comments guests type in their bank transfer, before they
# show on the big screen (rude ones are dropped or politely reworded). From platform.openai.com -> API keys.
# Without it, a basic rude-word list is used. OPENAI_MODEL is optional (default gpt-4o-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: relay for the live camera (a phone streaming to the big screen), for venues whose
# Wi-Fi or mobile network blocks direct connections. Free Cloudflare account:
# dash.cloudflare.com -> Realtime -> TURN Server -> Create. Copy the "Turn Token ID" and "API Token".
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
