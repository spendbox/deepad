# Copy these into Vercel: Project -> Settings -> Environment Variables.

# Password for your own admin page at /admin. REQUIRED.
ADMIN_PASSWORD=

# Long random text that protects everyone's logins. REQUIRED.
ADMIN_SESSION_SECRET=

# Supabase: Project Settings -> API. REQUIRED.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: Settings -> API Keys & Webhooks.
# sk_test_… = test mode (fake money). sk_live_… = real money.
PAYSTACK_SECRET_KEY=

# Email for planners' after-event reports, via resend.com (free plan is fine).
RESEND_API_KEY=
EMAIL_FROM=DashPad <reports@yourdomain.com>

# Any long random text. Lets Vercel run the daily clean-up job.
CRON_SECRET=

# Optional: your site's public address (e.g. https://dashpad.ng), used in event links.
NEXT_PUBLIC_SITE_URL=

# Optional: background removal for celebrant photos. FAPIhub (fapihub.com) has 100 free photos a month.
FAPIHUB_API_KEY=
# Or Photoroom (photoroom.com/api), used only if FAPIHUB_API_KEY is empty.
PHOTOROOM_API_KEY=
