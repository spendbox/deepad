# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Leave a line out and the app falls back to the safe "demo" behaviour.

# Password for /admin. REQUIRED on the live site.
ADMIN_PASSWORD=

# Any long random text. Changing it logs everyone out of the admin portal.
ADMIN_SESSION_SECRET=

# Supabase: Project Settings -> API. Without these the app uses a practice
# database that forgets everything when the server restarts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: Settings -> API Keys & Webhooks.
# Empty      = demo mode (fake account numbers, "pretend I've paid" buttons).
# sk_test_…  = Paystack test mode (real Paystack, fake money).
# sk_live_…  = LIVE, real money. Test buttons switch off automatically.
PAYSTACK_SECRET_KEY=

# Optional: your site's public address, used in QR codes (e.g. https://dashpad.ng).
NEXT_PUBLIC_SITE_URL=
